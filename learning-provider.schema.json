{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brasa.education/schemas/learning-provider.v1.json",
  "title": "BRASA learning provider catalog",
  "type": "object",
  "required": ["schemaVersion", "catalog", "status", "updatedAt", "disclaimer", "providers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalog": { "const": "BRASA Global Learning Network" },
    "status": { "const": "curated-discovery" },
    "updatedAt": { "type": "string", "format": "date" },
    "disclaimer": { "type": "string", "minLength": 40 },
    "providers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "owner", "url", "access", "cost", "languages", "formats", "offline", "credentials", "skills", "careers", "geography", "review"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "name": { "type": "string" }, "owner": { "type": "string" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }, "access": { "type": "string" }, "cost": { "type": "string" },
          "languages": { "$ref": "#/$defs/stringList" }, "formats": { "$ref": "#/$defs/stringList" }, "offline": { "type": "string" },
          "credentials": { "$ref": "#/$defs/stringList" }, "skills": { "$ref": "#/$defs/stringList" }, "careers": { "$ref": "#/$defs/stringList" }, "geography": { "type": "string" },
          "review": { "type": "object", "additionalProperties": false, "required": ["status", "reviewedAt", "nextReviewAt"], "properties": { "status": { "enum": ["reviewed", "needs-review", "suspended"] }, "reviewedAt": { "type": "string", "format": "date" }, "nextReviewAt": { "type": "string", "format": "date" } } }
        }
      }
    }
  },
  "$defs": { "stringList": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } }
}
